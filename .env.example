# Copy to .env, then fill in. compose.yml reads this file with env_file, which
# does no variable interpolation, so a bcrypt hash can be pasted verbatim.
# Do not add quotes; they are not stripped.
#
# Generate the hash with:
#   echo 'your-password' | podman run --rm -i localhost/physiobase hash-password
PHYSIOBASE_USERNAME=admin
PHYSIOBASE_PASSWORD_HASH=
